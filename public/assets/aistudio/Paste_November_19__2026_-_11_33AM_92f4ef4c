},

processPay() {
const amount = document.getElementById('payAmount')?.value;
if (!amount) return App.toast('Entrez un montant','error');
App.closeModal();
App.toast(`Paiement de ${parseInt(amount).toLocaleString()} FCFA confirmé ! ✅`, 'success');
const newCoti = {
id: Date.now(),
event: document.getElementById('payEvent')?.value || 'Événement',
amount: parseInt(amount),
status: 'paid',
date: new Date().toISOString().split('T')[0]
};
DEMO_COTISATIONS.unshift(newCoti);
this.render();
},

pay(id) {
const c = DEMO_COTISATIONS.find(x => x.id === id);
if (c) {
c.status = 'paid';
c.date = new Date().toISOString().split('T')[0];
App.toast('Cotisation payée ! ✅','success');
this.render();
}
}
};


