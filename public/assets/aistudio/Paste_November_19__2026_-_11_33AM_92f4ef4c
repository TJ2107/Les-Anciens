},

showPayModal() {
App.showModal(`
<div class="modal-title">💳 Payer une cotisation</div>
<div class="form-group">
<label class="form-label">Événement</label>
<select class="form-select" id="payEvent">
${DEMO_EVENTS.map(e => `<option>${e.name}</option>`).join('')}
