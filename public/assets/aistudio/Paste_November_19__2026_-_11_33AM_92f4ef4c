# 🎓 "Les Anciens" — Application Réseau des Anciens Étudiants

Application web complète, responsive, en un seul fichier HTML.

```html
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Les Anciens — Réseau des Anciens Étudiants</title>
<style>
:root{
--bg:#0f1117;--bg2:#1a1d2e;--bg3:#252840;--bg4:#2d3050;
--gold:#d4a843;--gold2:#f0c75e;--gold3:#b8922e;
--accent:#e8b930;--accent2:#f5d76e;
--text:#e8e0d0;--text2:#a09888;--text3:#605848;
--red:#e74c3c;--green:#2ecc71;--blue:#3498db;--purple:#9b59b6;
--border:rgba(212,168,67,.15);--border2:rgba(212,168,67,.3);
--shadow:0 4px 20px rgba(0,0,0,.4);--shadow2:0 8px 40px rgba(0,0,0,.5);
--radius:12px;--radius2:18px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:var(--text);font-family:'Segoe UI',system-ui,-apple-system,sans-serif;line-height:1.6;min-height:100vh}
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:var(--bg2)}
::-webkit-scrollbar-thumb{background:var(--gold3);border-radius:3px}
a{color:var(--gold);text-decoration:none}
img{max-width:100%;border-radius:var(--radius)}
button{font-family:inherit;cursor:pointer}

/* ═══ NAVIGATION ═══ */
.navbar{position:fixed;top:0;left:0;right:0;height:64px;background:rgba(15,17,23,.95);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 20px;z-index:100}
.nav-logo{display:flex;align-items:center;gap:10px;font-size:1.4em;font-weight:800;color:var(--gold)}
.nav-logo span{background:linear-gradient(135deg,var(--gold),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.nav-links{display:flex;gap:4px}
.nav-link{padding:8px 18px;border-radius:var(--radius);color:var(--text2);font-size:.95em;font-weight:600;transition:all .2s;cursor:pointer;border:none;background:none;position:relative}
.nav-link:hover,.nav-link.active{color:var(--gold);background:rgba(212,168,67,.1)}
.nav-link.active::after{content:'';position:absolute;bottom:0;left:20%;right:20%;height:2px;background:var(--gold);border-radius:1px}
.nav-user{display:flex;align-items:center;gap:12px}
.nav-avatar{width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--purple));display:flex;align-items:center;justify-content:center;font-size:1.1em;cursor:pointer;border:2px solid var(--border2)}
.nav-bell{position:relative;width:38px;height:38px;border-radius:50%;background:var(--bg3);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:1.1em}
.nav-bell .badge{position:absolute;top:-2px;right:-2px;width:18px;height:18px;background:var(--red);border-radius:50%;font-size:.65em;display:flex;align-items:center;justify-content:center;color:#fff}
.menu-toggle{display:none;background:none;border:none;color:var(--text);font-size:1.5em;cursor:pointer}

/* ═══ LAYOUT ═══ */
.main{margin-top:64px;padding:20px;max-width:1200px;margin-left:auto;margin-right:auto}
.page{display:none}
.page.active{display:block;animation:fadeUp .3s ease}
@keyframes fadeUp{from{opacity:0;transform:translateY(15px)}to{opacity:1;transform:translateY(0)}}

/* ═══ CARDS ═══ */
.card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius2);padding:20px;margin-bottom:16px;transition:all .2s}
.card:hover{border-color:var(--border2);box-shadow:var(--shadow)}
.card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.card-title{font-size:1.15em;font-weight:700;color:var(--gold)}
.card-subtitle{font-size:.85em;color:var(--text2)}

/* ═══ BUTTONS ═══ */
.btn{display:inline-flex;align-items:center;gap:8px;padding:10px 22px;border-radius:var(--radius);font-size:.92em;font-weight:600;border:none;transition:all .2s}
.btn-gold{background:linear-gradient(135deg,var(--gold),var(--gold3));color:#111}
.btn-gold:hover{transform:translateY(-2px);box-shadow:0 4px 15px rgba(212,168,67,.4)}
.btn-outline{background:transparent;border:2px solid var(--border2);color:var(--gold)}
.btn-outline:hover{background:rgba(212,168,67,.1);transform:translateY(-1px)}
.btn-sm{padding:6px 14px;font-size:.82em}
.btn-danger{background:var(--red);color:#fff}
.btn-danger:hover{background:#c0392b}
.btn-blue{background:var(--blue);color:#fff}
.btn-green{background:var(--green);color:#111}

/* ═══ FORMS ═══ */
.form-group{margin-bottom:18px}
.form-label{display:block;font-size:.9em;font-weight:600;color:var(--text2);margin-bottom:6px}
.form-input{width:100%;padding:12px 16px;border:2px solid var(--border);border-radius:var(--radius);background:var(--bg3);color:var(--text);font-size:.95em;transition:all .2s;font-family:inherit}
.form-input:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,168,67,.15)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.form-select{appearance:none;background:var(--bg3);border:2px solid var(--border);border-radius:var(--radius);padding:12px 16px;color:var(--text);font-size:.95em;width:100%}
.form-textarea{min-height:80px;resize:vertical}

/* ═══ AUTH SCREEN ═══ */
.auth-screen{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;z-index:200}
.auth-screen.hidden{display:none}
.auth-container{width:min(480px,92vw);text-align:center}
.auth-logo{font-size:3em;margin-bottom:8px}
.auth-title{font-size:2em;font-weight:800;color:var(--gold);margin-bottom:4px}
.auth-sub{color:var(--text2);margin-bottom:28px}
.auth-tabs{display:flex;gap:0;margin-bottom:20px;background:var(--bg3);border-radius:var(--radius);overflow:hidden}
.auth-tab{flex:1;padding:12px;border:none;background:transparent;color:var(--text2);font-weight:600;font-size:.95em;cursor:pointer;transition:all .2s}
.auth-tab.active{background:var(--gold);color:#111}

/* ═══ DASHBOARD ═══ */
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:20px}
.stat-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius2);padding:18px;text-align:center}
.stat-icon{font-size:2em;margin-bottom:6px}
.stat-number{font-size:1.8em;font-weight:800;color:var(--gold)}
.stat-label{font-size:.82em;color:var(--text2)}
.welcome-banner{background:linear-gradient(135deg,rgba(212,168,67,.15),rgba(155,89,182,.1));border:1px solid var(--border2);border-radius:var(--radius2);padding:28px;margin-bottom:20px;display:flex;align-items:center;gap:20px}
.welcome-avatar{width:70px;height:70px;border-radius:50%;background:linear-gradient(135deg,var(--gold),var(--purple));display:flex;align-items:center;justify-content:center;font-size:2em;flex-shrink:0}
.welcome-info h2{color:var(--gold);font-size:1.4em}
.welcome-info p{color:var(--text2);font-size:.95em}

/* ═══ ALUMNI LIST ═══ */
.alumni-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:14px}
.alumni-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius2);padding:18px;transition:all .2s;display:flex;gap:14px}
.alumni-card:hover{border-color:var(--gold);transform:translateY(-3px);box-shadow:var(--shadow2)}
.alumni-avatar{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5em;flex-shrink:0}
.alumni-info{flex:1}
.alumni-name{font-weight:700;font-size:1.05em;color:var(--text)}
.alumni-detail{font-size:.82em;color:var(--text2);margin:2px 0}
.alumni-badge{display:inline-block;padding:2px 10px;border-radius:20px;font-size:.72em;font-weight:700}
.badge-online{background:rgba(46,204,113,.2);color:var(--green)}
.badge-offline{background:rgba(150,150,150,.2);color:var(--text2)}
.badge-promo{background:rgba(212,168,67,.2);color:var(--gold)}
.badge-new{background:rgba(52,152,219,.2);color:var(--blue)}
.badge-memorial{background:rgba(231,76,60,.15);color:var(--red)}

/* ═══ POSTS / FEED ═══ */
.post-card{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius2);padding:20px;margin-bottom:14px}
.post-header{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.post-avatar{width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.2em;flex-shrink:0}
.post-meta{flex:1}
.post-author{font-weight:700;font-size:.98em}
.post-time{font-size:.78em;color:var(--text3)}
.post-type{display:inline-block;padding:2px 10px;border-radius:20px;font-size:.72em;font-weight:700;margin-left:8px}
.post-body{margin-bottom:14px;line-height:1.7;color:var(--text)}
.post-media{border-radius:var(--radius);overflow:hidden;margin:12px 0;max-height:350px;background:var(--bg3)}
.post-media img,.post-media video{width:100%;height:100%;object-fit:cover}
.post-actions{display:flex;gap:8px;padding-top:12px;border-top:1px solid var(--border)}
.post-action{display:flex;align-items:center;gap:6px;padding:8px 16px;border-radius:var(--radius);background:transparent;border:none;color:var(--text2);font-size:.88em;cursor:pointer;transition:all .2s}
.post-action:hover{background:rgba(212,168,67,.1);color:var(--gold)}
.post-action.liked{color:var(--red)}
.comment-section{margin-top:14px;padding-top:14px;border-top:1px solid var(--border)}
.comment{display:flex;gap:10px;margin-bottom:12px}
.comment-avatar{width:32px;height:32px;border-radius:50%;background:var(--bg4);display:flex;align-items:center;justify-content:center;font-size:.85em;flex-shrink:0}
.comment-body{flex:1}
.comment-author{font-weight:700;font-size:.85em;color:var(--gold)}
.comment-text{font-size:.88em;color:var(--text2)}
.comment-input{display:flex;gap:8px;margin-top:10px}
.comment-input input{flex:1;padding:10px 14px;border:1px solid var(--border);border-radius:var(--radius);background:var(--bg3);color:var(--text);font-size:.88em}

/* ═══ POST CREATOR ═══ */
.post-creator{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius2);padding:20px;margin-bottom:16px}
.post-creator-top{display:flex;gap:12px;align-items:flex-start}
.post-creator-top textarea{flex:1;min-height:60px;padding:12px;border:1px solid var(--border);border-radius:var(--radius);background:var(--bg3);color:var(--text);font-family:inherit;resize:vertical;font-size:.95em}
.post-creator-actions{display:flex;justify-content:space-between;align-items:center;margin-top:12px}
.post-media-preview{margin-top:12px;border-radius:var(--radius);overflow:hidden;max-height:200px;display:none}
.post-type-select{display:flex;gap:8px;flex-wrap:wrap}
.type-btn{padding:6px 14px;border-radius:20px;border:1px solid var(--border2);background:transparent;color:var(--text2);font-size:.82em;cursor:pointer;transition:all .2s}
.type-btn.active{background:var(--gold);color:#111;border-color:var(--gold)}

/* ═══ COTISATIONS ═══ */
.coti-table{width:100%;border-collapse:collapse}
.coti-table th{background:var(--bg3);padding:12px 14px;text-align:left;font-size:.85em;color:var(--gold);border-bottom:2px solid var(--border2)}
.coti-table td{padding:12px 14px;border-bottom:1px solid var(--border);font-size:.9em}
.coti-table tr:hover{background:rgba(212,168,67,.05)}
.status-paid{color:var(--green);font-weight:700}
.status-pending{color:var(--gold2);font-weight:700}
.status-overdue{color:var(--red);font-weight:700}
.progress-ring{width:80px;height:80px;position:relative}
.progress-ring svg{transform:rotate(-90deg)}
.progress-ring circle{fill:none;stroke-width:6;stroke-linecap:round}
.progress-ring .bg{stroke:var(--bg3)}
.progress-ring .fg{stroke:var(--gold);transition:stroke-dashoffset .5s}
.progress-ring .label{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:.9em;font-weight:800;color:var(--gold)}

/* ═══ DISCUSSIONS ═══ */
.chat-container{display:grid;grid-template-columns:280px 1fr;gap:16px;height:calc(100vh - 120px)}
.chat-sidebar{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius2);overflow-y:auto}
.chat-item{display:flex;align-items:center;gap:12px;padding:14px;cursor:pointer;transition:all .2s;border-bottom:1px solid var(--border)}
.chat-item:hover,.chat-item.active{background:rgba(212,168,67,.08)}
.chat-item-avatar{width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.1em;flex-shrink:0}
.chat-item-info{flex:1;min-width:0}
.chat-item-name{font-weight:700;font-size:.92em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-item-preview{font-size:.8em;color:var(--text3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-item-time{font-size:.72em;color:var(--text3)}
.chat-main{background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius2);display:flex;flex-direction:column}
.chat-header{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px}
.chat-messages{flex:1;overflow-y:auto;padding:18px;display:flex;flex-direction:column;gap:12px}
.msg{display:flex;gap:10px;max-width:75%}
.msg.sent{align-self:flex-end;flex-direction:row-reverse}
.msg-avatar{width:32px;height:32px;border-radius:50%;background:var(--bg4);display:flex;align-items:center;justify-content:center;font-size:.85em;flex-shrink:0}
.msg-bubble{padding:10px 16px;border-radius:18px;font-size:.9em;line-height:1.5}
.msg.received .msg-bubble{background:var(--bg3);border-bottom-left-radius:4px}
.msg.sent .msg-bubble{background:var(--gold);color:#111;border-bottom-right-radius:4px}
.msg-time{font-size:.68em;color:var(--text3);margin-top:4px}
.chat-input{display:flex;gap:8px;padding:14px 18px;border-top:1px solid var(--border)}
.chat-input input{flex:1;padding:12px 16px;border:1px solid var(--border);border-radius:24px;background:var(--bg3);color:var(--text);font-size:.92em}
.chat-input input:focus{outline:none;border-color:var(--gold)}

/* ═══ MODAL ═══ */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:150;display:flex;align-items:center;justify-content:center;animation:fadeIn .2s}
.modal-overlay.hidden{display:none}
.modal{background:var(--bg2);border:1px solid var(--border2);border-radius:var(--radius2);padding:28px;width:min(520px,92vw);max-height:85vh;overflow-y:auto;animation:scaleIn .25s ease}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes scaleIn{from{opacity:0;transform:scale(.95)}to{opacity:1;transform:scale(1)}}
.modal-close{position:absolute;top:14px;right:14px;width:32px;height:32px;border-radius:50%;background:var(--bg3);border:none;color:var(--text);font-size:1.1em;cursor:pointer;display:flex;align-items:center;justify-content:center}
.modal-title{font-size:1.3em;font-weight:800;color:var(--gold);margin-bottom:16px}

/* ═══ SEARCH & FILTERS ═══ */
.search-bar{display:flex;gap:10px;margin-bottom:16px}
.search-input{flex:1;padding:12px 18px;border:2px solid var(--border);border-radius:28px;background:var(--bg2);color:var(--text);font-size:.95em}
.search-input:focus{outline:none;border-color:var(--gold)}
.filter-bar{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap}
.filter-chip{padding:8px 18px;border-radius:20px;border:1px solid var(--border2);background:transparent;color:var(--text2);font-size:.85em;cursor:pointer;transition:all .2s}
.filter-chip.active{background:var(--gold);color:#111;border-color:var(--gold)}

/* ═══ NOTIFICATION TOAST ═══ */
.toast-container{position:fixed;top:80px;right:20px;z-index:300;display:flex;flex-direction:column;gap:8px}
.toast{background:var(--bg2);border:1px solid var(--border2);border-radius:var(--radius);padding:14px 20px;min-width:280px;box-shadow:var(--shadow2);animation:slideIn .3s ease;display:flex;align-items:center;gap:10px}
.toast.success{border-left:4px solid var(--green)}
.toast.error{border-left:4px solid var(--red)}
.toast.info{border-left:4px solid var(--gold)}
@keyframes slideIn{from{opacity:0;transform:translateX(30px)}to{opacity:1;transform:translateX(0)}}

/* ═══ RESPONSIVE ═══ */
@media(max-width:768px){
.navbar{padding:0 12px}
.nav-links{display:none;position:absolute;top:64px;left:0;right:0;background:var(--bg2);flex-direction:column;padding:12px;border-bottom:1px solid var(--border)}
.nav-links.open{display:flex}
.menu-toggle{display:block}
.nav-user .nav-name{display:none}
.stats-grid{grid-template-columns:repeat(2,1fr)}
.form-row{grid-template-columns:1fr}
.chat-container{grid-template-columns:1fr}
.chat-sidebar{display:none}
.chat-sidebar.open{display:block;position:absolute;left:0;top:0;bottom:0;z-index:10;width:280px}
.alumni-grid{grid-template-columns:1fr}
.welcome-banner{flex-direction:column;text-align:center}
.msg{max-width:90%}
}
</style>
</head>
<body>

<!-- ═══ ÉCRAN AUTHENTIFICATION ═══ -->
<div class="auth-screen" id="authScreen">
<div class="auth-container">
<div class="auth-logo">🎓</div>
<h1 class="auth-title">Les Anciens</h1>
<p class="auth-sub">Réseau des anciens étudiants du monde entier</p>
<div class="auth-tabs">
<button class="auth-tab active" onclick="Auth.switchTab('login')">Connexion</button>
<button class="auth-tab" onclick="Auth.switchTab('register')">Inscription</button>
</div>

<!-- Connexion -->
<div id="loginForm">
<div class="form-group">
<input type="email" class="form-input" id="loginEmail" placeholder="Adresse email">
</div>
<div class="form-group">
<input type="password" class="form-input" id="loginPass" placeholder="Mot de passe">
</div>
<button class="btn btn-gold" style="width:100%" onclick="Auth.login()">Se connecter</button>
<button class="btn btn-outline" style="width:100%;margin-top:8px" onclick="Auth.demo()">🎮 Mode démo</button>
</div>

<!-- Inscription -->
<div id="registerForm" style="display:none">
<div class="form-row">
<div class="form-group">
<input type="text" class="form-input" id="regName" placeholder="Nom complet">
</div>
<div class="form-group">
<input type="email" class="form-input" id="regEmail" placeholder="Email">
</div>
</div>
<div class="form-row">
<div class="form-group">
<input type="password" class="form-input" id="regPass" placeholder="Mot de passe">
</div>
<div class="form-group">
<select class="form-select" id="regCountry">
<option value="">Pays</option>
<option>🇨🇲 Cameroun</option>
<option>🇸🇳 Sénégal</option>
<option>🇨🇮 Côte d'Ivoire</option>
<option>🇨🇩 RD Congo</option>
<option>🇧🇫 Burkina Faso</option>
<option>🇲🇱 Mali</option>
<option>🇬🇦 Gabon</option>
<option>🇬🇳 Guinée</option>
<option>🇹🇬 Togo</option>
<option>🇧🇯 Bénin</option>
<option>🇫🇷 France</option>
<option>🇨🇦 Canada</option>
<option>🇧🇪 Belgique</option>
<option>Other</option>
</select>
</div>
</div>
<div class="form-row">
<div class="form-group">
<input type="text" class="form-input" id="regUniv" placeholder="Université">
</div>
<div class="form-group">
<select class="form-select" id="regYear">
<option value="">Année de promotion</option>
<option>2024</option><option>2023</option><option>2022</option>
<option>2021</option><option>2020</option><option>2019</option>
<option>2018</option><option>2017</option><option>2016</option>
<option>2015</option><option>2010</option><option>2005</option>
<option>2000</option><option>1995</option><option>1990</option>
<option>Other</option>
</select>
</div>
</div>
<div class="form-group">
<select class="form-select" id="regFiliere">
<option value="">Filière / Spécialité</option>
<option>Informatique</option><option>Médecine</option>
<option>Droit</option><option>Gestion</option>
<option>Ingénierie</option><option>Lettres</option>
<option>Sciences</option><option>Économie</option>
<option>Pharmacie</option><option>Autre</option>
</select>
</div>
<button class="btn btn-gold" style="width:100%" onclick="Auth.register()">Créer mon compte</button>
</div>
</div>
</div>

<!-- ═══ NAVIGATION ═══ -->
<nav class="navbar" id="navbar" style="display:none">
<button class="menu-toggle" onclick="App.toggleMenu()">☰</button>
<div class="nav-logo">🎓 <span>Les Anciens</span></div>
<div class="nav-links" id="navLinks">
<button class="nav-link active" onclick="App.nav('dashboard')" data-page="dashboard">📊 Tableau de bord</button>
<button class="nav-link" onclick="App.nav('alumni')" data-page="alumni">👥 Anciens</button>
<button class="nav-link" onclick="App.nav('info')" data-page="info">📰 Informations</button>
<button class="nav-link" onclick="App.nav('cotisations')" data-page="cotisations">💰 Cotisations</button>
<button class="nav-link" onclick="App.nav('discussions')" data-page="discussions">💬 Discussions</button>
