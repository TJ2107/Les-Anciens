// ═══════════════════════════════════════════════════════════

const Feed = {
postType: 'info',
filterType: 'all',
mediaData: null,

setType(type, el) {
this.postType = type;
document.querySelectorAll('.type-btn').forEach(b => b.classList.remove('active'));
if (el) el.classList.add('active');
},

setFilter(type, el) {
this.filterType = type;
document.querySelectorAll('#page-info .filter-chip').forEach(c => c.classList.remove('active'));
if (el) el.classList.add('active');
this.render();
},

previewMedia(e) {
const file = e.target.files[0];
if (!file) return;
const reader = new FileReader();
reader.onload = ev => {
this.mediaData = ev.target.result;
const preview = document.getElementById('postMediaPreview');
preview.style.display = 'block';
preview.innerHTML = file.type.startsWith('video') ?
`<video src="${ev.target.result}" style="width:100%;max-height:200px;object-fit:cover;border-radius:var(--radius)" controls></video>` :
`<img src="${ev.target.result}" style="width:100%;max-height:200px;object-fit:cover;border-radius:var(--radius)">`;
};
reader.readAsDataURL(file);
},

previewVideo() {
document.getElementById('postMedia').accept = 'video/*';
document.getElementById('postMedia').click();
App.toast('Vidéo courte (< 1 min) recommandée','info');
},

publish() {
const text = document.getElementById('postText').value.trim();
if (!text && !this.mediaData) return App.toast('Écrivez quelque part ou ajoutez un média','error');

const u = Auth.currentUser;
const newPost = {
id: Date.now(),
author: u?.name || 'Vous',
avatar: u?.avatar || '👤',
type: this.postType,
time: 'À l\'instant',
text: text || '(Média partagé)',
media: this.mediaData,
likes: 0,
comments: []
};

DEMO_POSTS.unshift(newPost);
document.getElementById('postText').value = '';
document.getElementById('postMediaPreview').style.display = 'none';
document.getElementById('postMedia').value = '';
this.mediaData = null;

this.render();
App.toast('Publication envoyée ! 🎉','success');
},

render() {
const container = document.getElementById('feedList');
if (!container) return;

let posts = [...DEMO_POSTS];
if (this.filterType !== 'all') posts = posts.filter(p => p.type === this.filterType);

const typeLabels = {
info: '<span class="post-type" style="background:rgba(52,152,219,.15);color:#3498db">📢 Info</span>',
promotion: '<span class="post-type" style="background:rgba(212,168,67,.15);color:var(--gold)">🎓 Promotion</span>',
naissance: '<span class="post-type" style="background:rgba(46,204,113,.15);color:var(--green)">👶 Naissance</span>',
deces: '<span class="post-type" style="background:rgba(231,76,60,.15);color:var(--red)">🕊️ Décès</span>',
evenement: '<span class="post-type" style="background:rgba(155,89,182,.15);color:var(--purple)">🎉 Événement</span>',
emploi: '<span class="post-type" style="background:rgba(241,196,15,.15);color:#f1c40f">💼 Emploi</span>'
};

container.innerHTML = posts.map(p => `
<div class="post-card" id="post-${p.id}">
<div class="post-header">
<div class="post-avatar" style="background:var(--bg3)">${p.avatar}</div>
<div class="post-meta">
<div class="post-author">${p.author} ${typeLabels[p.type] || ''}</div>
<div class="post-time">${p.time}</div>
</div>
</div>
<div class="post-body">${p.text}</div>
${p.media ? `<div class="post-media">${p.media.startsWith('data:video') ? `<video src="${p.media}" controls style="width:100%;max-height:350px"></video>` : `<img src="${p.media}">`}</div>` : ''}
<div class="post-actions">
<button class="post-action ${p.liked ? 'liked' : ''}" onclick="Feed.like(${p.id})">❤️ ${p.likes || 0}</button>
<button class="post-action" onclick="Feed.toggleComments(${p.id})">💬 ${p.comments?.length || 0} commentaires</button>
<button class="post-action" onclick="App.toast('Lien copié !','success')">🔗 Partager</button>
</div>
<div class="comment-section" id="comments-${p.id}" style="display:${p.showComments ? 'block' : 'none'}">
${(p.comments || []).map(c => `
<div class="comment">
<div class="comment-avatar" style="background:var(--bg3)">${c.avatar || '👤'}</div>
<div class="comment-body">
<div class="comment-author">${c.author}</div>
<div class="comment-text">${c.text}</div>
</div>
</div>
`).join('')}
<div class="comment-input">
<input type="text" placeholder="Ajouter un commentaire..." id="commentInput-${p.id}"
onkeydown="if(event.key==='Enter')Feed.addComment(${p.id})">
<button class="btn btn-gold btn-sm" onclick="Feed.addComment(${p.id})">Envoyer</button>
</div>
</div>
</div>
`).join('') || '<div style="text-align:center;color:var(--text2);padding:40px">Aucune publication.</div>';
},

like(id) {
const post = DEMO_POSTS.find(p => p.id === id);
if (!post) return;
post.liked = !post.liked;
post.likes = (post.likes || 0) + (post.liked ? 1 : -1);
this.render();
},

toggleComments(id) {
const post = DEMO_POSTS.find(p => p.id === id);
if (!post) return;
post.showComments = !post.showComments;
this.render();
if (post.showComments) {
const input = document.getElementById(`commentInput-${id}`);
if (input) input.focus();
}
},

addComment(id) {
const input = document.getElementById(`commentInput-${id}`);
if (!input || !input.value.trim()) return;
const post = DEMO_POSTS.find(p => p.id === id);
if (!post) return;
if (!post.comments) post.comments = [];
const u = Auth.currentUser;
post.comments.push({
author: u?.name || 'Vous',
avatar: u?.avatar || '👤',
text: input.value.trim()
});
input.value = '';
this.render();
}
};


