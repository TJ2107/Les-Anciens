const Auth = {
currentUser: null,

switchTab(tab) {
document.querySelectorAll('.auth-tab').forEach((t,i) => {
t.classList.toggle('active', (tab==='login'&&i===0)||(tab==='register'&&i===1));
});
document.getElementById('loginForm').style.display = tab==='login' ? 'block' : 'none';
document.getElementById('registerForm').style.display = tab==='register' ? 'block' : 'none';
},

login() {
const email = document.getElementById('loginEmail').value.trim();
const pass = document.getElementById('loginPass').value;
if (!email || !pass) return App.toast('Veuillez remplir tous les champs','error');

// Check localStorage users
const users = JSON.parse(localStorage.getItem('anciens_users') || '[]');
const user = users.find(u => u.email === email && u.password === pass);
if (user) {
this.currentUser = user;
this.enter();
} else {
App.toast('Email ou mot de passe incorrect','error');
}
},

register() {
const name = document.getElementById('regName').value.trim();
const email = document.getElementById('regEmail').value.trim();
const pass = document.getElementById('regPass').value;
const country = document.getElementById('regCountry').value;
const univ = document.getElementById('regUniv').value.trim();
const year = document.getElementById('regYear').value;
const filiere = document.getElementById('regFiliere').value;

if (!name || !email || !pass || !country || !univ) return App.toast('Veuillez remplir tous les champs obligatoires','error');
if (pass.length < 6) return App.toast('Mot de passe trop court (6 caractères min)','error');

const users = JSON.parse(localStorage.getItem('anciens_users') || '[]');
if (users.find(u => u.email === email)) return App.toast('Cet email est déjà utilisé','error');

const user = {
id: Date.now(), name, email, password: pass,
country, univ, year: year || '2024', filiere: filiere || 'Autre',
avatar: '👤', role: 'Ancien étudiant', city: '', bond: 0,
status: 'online', promo: `Promo ${year||'2024'}`
};
users.push(user);
localStorage.setItem('anciens_users', JSON.stringify(users));

this.currentUser = user;
this.enter();
App.toast('Inscription réussie ! Bienvenue 🎉','success');
},

demo() {
this.currentUser = {
id: 0, name: 'Amadou Kaboré', email: 'demo@anciens.com',
country: '🇨🇲 Cameroun', univ: 'Université de Yaoundé I',
year: '2018', filiere: 'Informatique',
avatar: '👨🏾‍💻', role: 'Développeur', city: 'Yaoundé',
bond: 4, status: 'online', promo: 'Promo 2018'
};
this.enter();
App.toast('Mode démo activé 🎮','info');
},

enter() {
document.getElementById('authScreen').classList.add('hidden');
document.getElementById('navbar').style.display = 'flex';
document.getElementById('mainContent').style.display = 'block';
localStorage.setItem('anciens_session', JSON.stringify(this.currentUser));
App.init();
},

logout() {
localStorage.removeItem('anciens_session');
this.currentUser = null;
document.getElementById('authScreen').classList.remove('hidden');
document.getElementById('navbar').style.display = 'none';
document.getElementById('mainContent').style.display = 'none';
App.toast('Déconnexion réussie','info');
},

deleteAccount() {
if (!confirm('Supprimer définitivement votre compte ?')) return;
const users = JSON.parse(localStorage.getItem('anciens_users') || '[]');
const idx = users.findIndex(u => u.email === this.currentUser?.email);
if (idx >= 0) users.splice(idx, 1);
localStorage.setItem('anciens_users', JSON.stringify(users));
this.logout();
},

restore() {
const session = localStorage.getItem('anciens_session');
if (session) {
this.currentUser = JSON.parse(session);
this.enter();
}
}
};


